*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,Helvetica,sans-serif;
}

body{
display:flex;
background:#0d1117;
color:#fff;
min-height:100vh;
}

.sidebar{
width:250px;
background:#161b22;
padding:20px;
position:fixed;
height:100%;
border-right:1px solid #30363d;
}

.sidebar h2{
color:#58a6ff;
margin-bottom:30px;
}

.sidebar ul{
list-style:none;
}

.sidebar li{
margin:18px 0;
}

.sidebar a{
color:white;
text-decoration:none;
font-size:17px;
transition:.3s;
}

.sidebar a:hover{
color:#58a6ff;
}

.main{
margin-left:270px;
padding:25px;
width:100%;
}

.cards{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
gap:20px;
margin:20px 0;
}

.card{
background:#161b22;
padding:20px;
border-radius:12px;
text-align:center;
border:1px solid #30363d;
}

.card h2{
font-size:34px;
color:#58a6ff;
margin-bottom:8px;
}

section{
background:#161b22;
padding:20px;
margin-bottom:25px;
border-radius:12px;
border:1px solid #30363d;
}

input,
select,
textarea{
width:100%;
padding:12px;
margin:10px 0;
background:#0d1117;
color:white;
border:1px solid #30363d;
border-radius:8px;
}

textarea{
height:120px;
resize:vertical;
}

button{
width:100%;
padding:14px;
background:#238636;
color:white;
border:none;
border-radius:8px;
font-size:16px;
cursor:pointer;
transition:.3s;
}

button:hover{
background:#2ea043;
}

table{
width:100%;
border-collapse:collapse;
margin-top:15px;
}

th{
background:#1f6feb;
padding:12px;
}

td{
padding:12px;
text-align:center;
border-bottom:1px solid #30363d;
}

canvas{
background:white;
border-radius:10px;
padding:10px;
}

@media(max-width:900px){

body{
flex-direction:column;
}

.sidebar{
position:relative;
width:100%;
height:auto;
}

.main{
margin-left:0;
}

.cards{
grid-template-columns:1fr;
}

table{
display:block;
overflow-x:auto;
}

}
        
