*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial,Helvetica,sans-serif;
}

body{
    background:#0d1117;
    color:#fff;
    padding:20px;
}

header{
    display:flex;
    justify-content:space-between;
    align-items:center;
    flex-wrap:wrap;
    margin-bottom:20px;
}

h1{
    color:#1f6feb;
    font-size:32px;
}

.header-buttons{
    display:flex;
    gap:10px;
}

button{
    background:#1f6feb;
    color:#fff;
    border:none;
    padding:10px 18px;
    border-radius:8px;
    cursor:pointer;
    font-size:15px;
    transition:.3s;
}

button:hover{
    background:#388bfd;
}

.stats{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(180px,1fr));
    gap:15px;
    margin-bottom:25px;
}

.card{
    background:#161b22;
    padding:20px;
    border-radius:12px;
    text-align:center;
    border:1px solid #30363d;
}

.card h2{
    font-size:30px;
    color:#58a6ff;
}

.card p{
    margin-top:8px;
    color:#c9d1d9;
}

.form,.chart{
    background:#161b22;
    padding:20px;
    border-radius:12px;
    margin-bottom:25px;
    border:1px solid #30363d;
}

.form h2,
.chart h2{
    margin-bottom:15px;
}

input,
select,
textarea{
    width:100%;
    padding:12px;
    margin:8px 0;
    border-radius:8px;
    border:1px solid #30363d;
    background:#0d1117;
    color:white;
    font-size:15px;
}

textarea{
    resize:vertical;
    min-height:90px;
}

#saveTrade{
    width:100%;
    margin-top:10px;
    font-size:16px;
}

table{
    width:100%;
    border-collapse:collapse;
    background:#161b22;
    border-radius:10px;
    overflow:hidden;
}

th{
    background:#1f6feb;
    color:#fff;
    padding:12px;
}

td{
    padding:12px;
    text-align:center;
    border-bottom:1px solid #30363d;
}

tr:nth-child(even){
    background:#0d1117;
}

canvas{
    background:white;
    border-radius:10px;
    padding:10px;
}

@media(max-width:768px){

header{
    flex-direction:column;
    gap:15px;
}

h1{
    font-size:26px;
    text-align:center;
}

.header-buttons{
    width:100%;
}

button{
    width:100%;
}

table{
    display:block;
    overflow-x:auto;
}

}
   
